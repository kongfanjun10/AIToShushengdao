.page {
  min-height: 100vh;
  padding-bottom: 240rpx;
}
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mini-ctrl {
  display: flex;
  align-items: center;
  gap: 15rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 9999rpx;
  padding: 4rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 38rpx;
}
.sync-pill {
  padding: 2rpx 8rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
  color: #0ea5e9;
  font-size: 19rpx;
  line-height: 27rpx;
  font-weight: 500;
}
.round-btn {
  width: 77rpx;
  height: 77rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* 时间筛选 */
.filters {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 9999rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.filter {
  flex: 1;
  padding: 6rpx 12rpx;
  border-radius: 9999rpx;
  text-align: center;
  font-size: 23rpx;
  line-height: 31rpx;
  font-weight: 600;
  color: var(--text-secondary);
}
.filter-on {
  background: #fff;
  color: #0ea5e9;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 46rpx;
  padding: 38rpx;
  display: flex;
  flex-direction: column;
  gap: 13rpx;
}

/* 用户卡 */
.user-card {
  gap: 13rpx;
}
.ava-ring {
  position: relative;
  width: 123rpx;
  height: 123rpx;
  border-radius: 50%;
  padding: 1rpx;
  background: linear-gradient(45deg, #fbbf24, #0ea5e9, #57dffe);
  flex-shrink: 0;
}
.ava-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--accent-purple-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  overflow: hidden;
}
.ava-photo-box {
  background: #fff;
}
.ava-photo {
  width: 100%;
  height: 100%;
  display: block;
}
.ava-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #fbbf24;
  color: #92400e;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.15);
}
.mode-tag {
  padding: 2rpx 8rpx;
  border-radius: 9999rpx;
  background: var(--surface-container-high);
  color: #0ea5e9;
  font-size: 19rpx;
  line-height: 27rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.streak {
  width: 100%;
  border-radius: 31rpx;
  padding: 10rpx 13rpx;
  background: linear-gradient(90deg, #fef3c7, rgba(237, 233, 254, 0.5));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.fire {
  width: 61rpx;
  height: 61rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* 总进度 */
.prog-card {
  gap: 12rpx;
}
.track {
  width: 100%;
  height: 12rpx;
  border-radius: 9999rpx;
  background: var(--surface-container-high);
  padding: 1rpx;
  overflow: hidden;
}
.track-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #0ea5e9);
}

/* 统计 */
.stats {
  display: flex;
  gap: 10rpx;
}
.stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 38rpx;
  padding: 27rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 8rpx 31rpx -4rpx rgba(14, 165, 233, 0.05);
}
.stat-ico {
  width: 61rpx;
  height: 61rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

/* 技能 */
.radar {
  gap: 27rpx;
}
.skills {
  display: flex;
  flex-direction: column;
  gap: 13rpx;
}
.skill {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.skill-ico {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.skill-track {
  width: 100%;
  height: 8rpx;
  border-radius: 9999rpx;
  background: var(--surface-container);
  overflow: hidden;
}
.skill-fill {
  height: 100%;
  border-radius: 9999rpx;
}

/* 勋章墙 */
.badges {
  gap: 13rpx;
}
.badge-h-ico {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--accent-purple-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.count-pill {
  padding: 2rpx 8rpx;
  border-radius: 9999rpx;
  background: var(--surface-container-high);
  color: var(--text-secondary);
  font-size: 19rpx;
  line-height: 27rpx;
  font-weight: 500;
}
.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 4rpx;
}
.badge-tile {
  width: calc((100% - 12rpx) / 2);
  position: relative;
  border-radius: 31rpx;
  padding: 23rpx;
  background: rgba(240, 243, 255, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.tile-tag {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  padding: 2rpx 6rpx;
  border-radius: 12rpx;
  font-size: 19rpx;
  line-height: 27rpx;
  font-weight: 500;
}
.tile-ring {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  padding: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.12);
}
.tile-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 家长中心 */
.parent-card {
  gap: 12rpx;
}
.parent-ico {
  width: 92rpx;
  height: 92rpx;
  border-radius: 31rpx;
  background: linear-gradient(45deg, #0369a1, #0ea5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.25);
}
.gate-tag {
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  background: var(--warning-bg);
  color: var(--warning-text);
  font-size: 19rpx;
  line-height: 27rpx;
  font-weight: 600;
}
.lock-circle {
  width: 61rpx;
  height: 61rpx;
  border-radius: 50%;
  background: var(--surface-container);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.parent-foot {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
}

/* 门禁弹窗 */
.mask {
  position: fixed;
  left: 0;right: 0;top: 0;bottom: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 38rpx;
}
.gate-modal {
  width: 100%;
  max-width: 654rpx;
  background: #fff;
  border-radius: 54rpx;
  padding: 46rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.3);
}
.gate-ico {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--accent-purple-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.gate-q {
  width: 100%;
  background: var(--surface-container-low);
  border-radius: 31rpx;
  padding: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
}
.gate-input {
  width: 100%;
  height: 92rpx;
  border-radius: 9999rpx;
  background: var(--surface-container);
  text-align: center;
  font-size: 35rpx;
  margin-bottom: 15rpx;
}
.gate-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ghost {
  background: var(--surface-container);
}
.solid {
  background: #0ea5e9;
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.3);
}

/* Tabbar */
.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 0 38rpx calc(12rpx + env(safe-area-inset-bottom));
}
.tabbar {
  position: relative;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 9999rpx;
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 23rpx 61rpx -8rpx rgba(30, 41, 59, 0.12), 0 8rpx 23rpx -4rpx rgba(14, 165, 233, 0.08);
}
.tab {
  flex: 1;
  min-height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--primary-container);
  font-weight: 600;
}
.tab-off {
  color: var(--text-secondary);
  font-weight: 400;
}
.tab-center {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tab-fab {
  position: absolute;
  top: -54rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(45deg, #0369a1, #0ea5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 38rpx rgba(14, 165, 233, 0.45);
}
.pressed {
  transform: scale(0.98);
  opacity: 0.94;
}

/* ===== 半屏面板（能力明细 / 全部勋章） ===== */
.mask-clear {
  align-items: flex-start;
  justify-content: flex-end;
  padding: 0;
  background: rgba(15, 23, 42, 0.06);
}
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  background: #fff;
  border-radius: 42rpx 42rpx 0 0;
  padding: 18rpx 38rpx calc(38rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.16);
}
.sheet-tall {
  max-height: 82vh;
}
.sheet-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #e2e8f0;
  margin: 0 auto 12rpx;
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-scroll {
  max-height: 58vh;
  margin-top: 10rpx;
}
.sheet-tall .sheet-scroll {
  max-height: 62vh;
}

/* 能力明细行 */
.sk-item {
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  background: var(--surface-container-low, #f8fafc);
  border: 1px solid rgba(148, 163, 184, 0.14);
  margin-bottom: 14rpx;
  display: flex;
  flex-direction: column;
}
.lv-tag {
  font-size: 19rpx;
  font-weight: 600;
  color: #0369a1;
  background: #f1e9ff;
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
}
.tip-box {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: #fffbeb;
}

/* 勋章明细行 */
.grp-title {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 1rpx;
  margin: 16rpx 0 10rpx;
}
.b-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1px solid rgba(148, 163, 184, 0.16);
  margin-bottom: 12rpx;
}
.b-locked {
  background: #fafbfd;
}
.b-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.b-ico-in {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.b-tag {
  font-size: 18rpx;
  font-weight: 600;
  color: #005b3d;
  background: #d1fae5;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
}
.b-tag-off {
  color: #00687a;
  background: #e0f2fe;
}
.b-track {
  width: 100%;
  height: 6rpx;
  border-radius: 9999rpx;
  background: #e2e8f0;
  overflow: hidden;
  margin: 6rpx 0 2rpx;
}
.b-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #22d3ee);
}

/* ===== 更多菜单 ===== */
.more-panel {
  position: absolute;
  top: 150rpx;
  right: 38rpx;
  width: 400rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 0;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.22);
  display: flex;
  flex-direction: column;
}
.more-item {
  padding: 20rpx 26rpx;
}
