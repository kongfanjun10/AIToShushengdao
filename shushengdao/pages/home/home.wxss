.page {
  min-height: 100vh;
  padding-bottom: 240rpx;
}

/* ==== 顶部导航 ==== */
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 问候语前的小头像（与「你好」同行，无外框） */
.hi-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--primary);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}
.hi-avatar-img {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: block;
}
/* 昵称旁的「改资料」小铅笔 */
.name-edit {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mini-ctrl {
  display: flex;
  align-items: center;
  gap: 15rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 9999rpx;
  padding: 4rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* ==== 主体 ==== */
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 38rpx;
}
.wave {
  font-size: 35rpx;
  display: inline-block;
  transform-origin: bottom right;
  animation: wave 1.5s ease-in-out infinite;
}
.bell-btn {
  width: 77rpx;
  height: 77rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
}
.mode-pill {
  padding: 4rpx 10rpx;
  border-radius: 9999rpx;
  background: rgba(237, 233, 254, 0.8);
  display: flex;
  align-items: center;
  gap: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-container);
}

/* ==== 主任务卡 ==== */
/* ==== 区块通用 ==== */
.section {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

/* ==== 断点续读卡 ==== */
.resume {
  padding: 31rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.squircle {
  width: 84rpx;
  height: 84rpx;
  border-radius: 23rpx;
  background: var(--accent-purple-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bullet {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
}
.bar {
  width: 100%;
  height: 10rpx;
  border-radius: 9999rpx;
  background: var(--surface-container);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #0ea5e9);
}
.resume-btn {
  height: 69rpx;
  padding: 0 31rpx;
  border-radius: 9999rpx;
  background: var(--surface-container-high);
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.resume-done-chip {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 9999rpx;
  background: #e7f7ef;
}
.resume-done-chip .t-10 {
  color: #00875a;
  font-weight: 600;
}

/* ==== 快速入口 ==== */
.quick {
  display: flex;
  gap: 10rpx;
}
.q-item {
  flex: 1;
  background: var(--surface-white);
  border-radius: 31rpx;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 6rpx 23rpx rgba(15, 23, 42, 0.03);
}
.q-ico {
  width: 92rpx;
  height: 92rpx;
  border-radius: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.q-purple {
  background: linear-gradient(45deg, #e0f2fe, #eaddff);
  color: #0369a1;
}
.q-teal {
  background: linear-gradient(45deg, #dcfce7, #6ffbbe);
  color: #007650;
}
.q-amber {
  background: linear-gradient(45deg, #fef3c7, #fde68a);
  color: #f97316;
}
.q-blue {
  background: linear-gradient(45deg, #e0f2fe, #acedff);
  color: #00687a;
}

/* ==== 勋章预告 ==== */
.badge-card {
  position: relative;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 31rpx;
  padding: 31rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}
.badge-glow {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 246rpx;
  height: 246rpx;
  border-radius: 50%;
  background: rgba(237, 233, 254, 0.5);
}
.badge-box {
  position: relative;
  width: 123rpx;
  height: 123rpx;
  border-radius: 31rpx;
  background: var(--surface-container-high);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.lock-dot {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #fbbf24;
  color: #92400e;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.18);
}
.rarity {
  padding: 2rpx 8rpx;
  border-radius: 9999rpx;
  background: var(--surface-container);
  color: var(--text-secondary);
  font-size: 19rpx;
  line-height: 27rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.streak-bar {
  width: 123rpx;
  height: 8rpx;
  border-radius: 9999rpx;
  background: var(--surface-container);
  overflow: hidden;
}
.streak-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: #f97316;
}

/* ==== Toast ==== */
.toast {
  position: fixed;
  top: 160rpx;
  left: 50%;
  transform: translate(-50%, -12rpx);
  max-width: 85vw;
  padding: 8rpx 15rpx;
  border-radius: 9999rpx;
  background: rgba(38, 49, 67, 0.92);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.24);
  display: flex;
  align-items: center;
  gap: 8rpx;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
  z-index: 99;
}
.toast-show {
  opacity: 1;
  transform: translate(-50%, 0);
}

/* ==== 底部悬浮导航 ==== */
/* ===== 顶部更多菜单 ===== */
.h-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(15, 23, 42, 0.06);
}
.more-panel {
  position: absolute;
  top: 150rpx;
  right: 38rpx;
  width: 400rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 0;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.22);
  display: flex;
  flex-direction: column;
}
.more-item {
  padding: 20rpx 26rpx;
}
.more-item.pressed {
  background: #f1f3f8;
}

/* ===== 学科分区 ===== */
.subjects {
  display: flex;
  gap: 10rpx;
}
.subject {
  flex: 1;
  padding: 16rpx 10rpx 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1.5px solid rgba(148, 163, 184, 0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
}
.subject-on {
  background: linear-gradient(150deg, #0369a1, #0ea5e9);
  border-color: transparent;
  box-shadow: 0 12rpx 28rpx rgba(14, 165, 233, 0.3);
}
.subj-ico {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}
.s-chn {
  background: linear-gradient(135deg, #e0f2fe, #eaddff);
  color: #0369a1;
}
.s-math {
  background: linear-gradient(135deg, #e0f2fe, #acedff);
  color: #00687a;
}
.s-eng {
  background: linear-gradient(135deg, #dcfce7, #6ffbbe);
  color: #007650;
}
.subj-name {
  color: var(--text-primary);
}
.subj-hint {
  color: var(--text-tertiary);
}
.subject-on .subj-name {
  color: #fff;
}
.subject-on .subj-hint {
  color: rgba(255, 255, 255, 0.78);
}
.pressed {
  transform: scale(0.985);
  opacity: 0.95;
}

/* ===== 文字描写卡 ===== */
.write-card {
  padding: 26rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.write-squircle {
  background: linear-gradient(135deg, #e0f2fe, #eaddff);
}
.go-pill {
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
  flex-shrink: 0;
}
.pv-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.pv-cell {
  width: 76rpx;
  height: 88rpx;
  border-radius: 16rpx;
  border: 1px dashed rgba(3, 105, 161, 0.28);
  background: #fffdf8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pv-py {
  font-size: 17rpx;
  line-height: 22rpx;
  color: var(--text-secondary);
}
.pv-char {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 40rpx;
  line-height: 46rpx;
  color: var(--text-primary);
}
/* 音标预览格：符号比汉字窄，字号小一档 */
.pv-ipa {
  font-family: "Lucida Sans Unicode", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== 数字测试卡 ===== */
.math-squircle {
  background: linear-gradient(135deg, #e0f2fe, #acedff);
}
.num-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.num-chip {
  min-width: 84rpx;
  height: 84rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(0, 104, 122, 0.16);
  background: linear-gradient(160deg, #f0f9ff, #e0f2fe);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--secondary);
  font-variant-numeric: tabular-nums;
}

/* ===== 数学 / 英语筹备卡 ===== */
.plan-card {
  position: relative;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  overflow: hidden;
}
.plan-glow {
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  opacity: 0.5;
}
.plan-ico {
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.prep-tag {
  font-size: 18rpx;
  line-height: 26rpx;
  font-weight: 600;
  color: #92400e;
  background: #fef3c7;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
  flex-shrink: 0;
}
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: var(--surface-container-low);
}
.plan-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.plan-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #94a3b8;
  margin-top: 14rpx;
  flex-shrink: 0;
}
.plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

/* ---------- 更多玩法（口算 / 竖式） ---------- */
.tool-card {
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  padding: 4rpx 20rpx;
  display: flex;
  flex-direction: column;
}
.tool-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 2rpx;
}
.row-hover {
  background: rgba(15, 23, 42, 0.03);
  border-radius: 20rpx;
}
.tool-sq {
  width: 78rpx;
  height: 78rpx;
  border-radius: 21rpx;
}
.tool-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 9999rpx;
  background: rgba(249, 115, 22, 0.12);
  color: #c2410c;
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 600;
}
.tool-hair {
  height: 1px;
  background: rgba(148, 163, 184, 0.16);
  margin-left: 92rpx;
}

/* ---------- 英语单词预览 ---------- */
.eng-squircle {
  background: linear-gradient(135deg, #dcfce7, #a7f3d0);
}
.wpre-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.wpre-cell {
  min-width: 108rpx;
  padding: 10rpx 8rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(4, 120, 87, 0.14);
  background: linear-gradient(160deg, #f0fdf4, #dcfce7);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}
.wpre-en {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: #065f46;
}
.wpre-cn {
  font-size: 17rpx;
  line-height: 22rpx;
  color: #047857;
}
.plan-mini {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(148, 163, 184, 0.16);
}

/* ---- 消息中心（铃铛弹层） ---- */
.bell-btn {
  position: relative;
}
.bell-dot {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 9999rpx;
  background: #f43f5e;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}
.notif-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.42);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.notif-sheet {
  width: 100%;
  max-height: 72vh;
  padding: 30rpx 34rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  animation: notifUp 0.22s ease-out;
}
@keyframes notifUp {
  from {
    transform: translateY(60rpx);
    opacity: 0.4;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.notif-close {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.notif-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 90rpx;
}
.ne-ico {
  font-size: 88rpx;
  line-height: 1;
}
.notif-list {
  max-height: 56vh;
}
.notif-item {
  position: relative;
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: #f0f9ff;
  margin-bottom: 14rpx;
}
.notif-item.read {
  background: #f8fafc;
}
.ni-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx -6rpx rgba(15, 23, 42, 0.2);
}
.ni-dot {
  position: absolute;
  right: 20rpx;
  top: 26rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f43f5e;
}
.notif-item.read .ni-dot {
  display: none;
}

/* ---------- 快速入口：收成页尾一条紧凑工具条 ---------- */
.quick-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 31rpx;
}
.qb-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.qb-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 23rpx;
}
.qb-sep {
  width: 1px;
  height: 46rpx;
  background: rgba(148, 163, 184, 0.22);
}
