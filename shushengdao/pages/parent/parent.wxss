.page {
  min-height: 100vh;
  padding-bottom: 240rpx;
}
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back-btn {
  width: 69rpx;
  height: 69rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hover-bg {
  background: rgba(3, 105, 161, 0.06);
}
.safe-pill {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: #d1fae5;
}
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

/* 门禁 */
.gate {
  margin-top: 40rpx;
  background: #fff;
  border-radius: 38rpx;
  padding: 40rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.gate-ico {
  width: 130rpx;
  height: 130rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #0369a1, #38bdf8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx -10rpx rgba(3, 105, 161, 0.5);
  margin-bottom: 6rpx;
}
.gate-expr {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--text-primary);
  margin: 14rpx 0 4rpx;
}
.gate-input {
  width: 100%;
  height: 92rpx;
  border-radius: 23rpx;
  background: #f8f7ff;
  border: 2rpx solid #e0f2fe;
  text-align: center;
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.ph {
  color: #94a3b8;
  font-weight: 400;
  font-size: 27rpx;
}
.gate-error {
  font-size: 21rpx;
  color: #f97316;
}
.btn-main {
  height: 92rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #0369a1, #38bdf8);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 12rpx 26rpx -8rpx rgba(3, 105, 161, 0.5);
  margin-top: 6rpx;
}
.pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.notice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(172, 237, 255, 0.45);
}

/* 周报卡 */
.report-card {
  position: relative;
  overflow: hidden;
  border-radius: 31rpx;
  padding: 26rpx;
  background: linear-gradient(135deg, #0369a1 0%, #0ea5e9 60%, #38bdf8 100%);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.report-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.2);
}
.chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 200rpx;
  padding: 0 4rpx;
}
.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  height: 100%;
}
.chart-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.chart-bar {
  width: 70%;
  min-height: 10rpx;
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  background: linear-gradient(180deg, #6ffbbe, #22d3ee);
  box-shadow: 0 4rpx 12rpx rgba(111, 251, 190, 0.35);
}
.chart-bar-idle {
  background: rgba(255, 255, 255, 0.25);
  box-shadow: none;
  min-height: 8rpx;
}
.chart-x {
  font-size: 19rpx;
  color: #d8c8ff;
}
.report-metrics {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 23rpx;
  padding: 16rpx 0;
}
.rm {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.rm-v {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}
/* 「3 分 20 秒」这类长时长缩小一号，避免挤爆指标格 */
.rm-v-sm {
  font-size: 26rpx;
  line-height: 40rpx;
}
.rm-k {
  font-size: 19rpx;
  color: #d8c8ff;
}
.rm-div {
  width: 1px;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.2);
}

.section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

/* 每日列表 */
.week-list {
  background: #fff;
  border-radius: 27rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx -12rpx rgba(14, 165, 233, 0.18);
}
.week-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
/* 左侧月日：11/05（今天高亮，便于一眼对上「今天」） */
.week-date {
  width: 96rpx;
  flex-shrink: 0;
}
.week-date-v {
  font-size: 22rpx;
  line-height: 1.1;
  color: #8b95ab;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  letter-spacing: 0.5rpx;
}
.week-date-today {
  color: #0369a1;
  font-weight: 700;
}
.week-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 9999rpx;
  background: #f1eefb;
  overflow: hidden;
}
.week-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #22d3ee);
}

/* 书单 */
.group-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.group-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 27rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 20rpx -10rpx rgba(14, 165, 233, 0.18);
}
.group-ico {
  width: 73rpx;
  height: 73rpx;
  border-radius: 23rpx;
  background: var(--accent-purple-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.group-bar {
  height: 8rpx;
  border-radius: 9999rpx;
  background: #f1eefb;
  margin-top: 8rpx;
  overflow: hidden;
}
.group-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #38bdf8);
}

/* 设置 */
.setting-card {
  background: #fff;
  border-radius: 27rpx;
  box-shadow: 0 8rpx 24rpx -12rpx rgba(14, 165, 233, 0.18);
  overflow: hidden;
}
.set-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 20rpx;
}
.seg {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 9999rpx;
  background: #f4f1fb;
}
.seg-item {
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  color: var(--text-secondary);
}
.seg-on {
  background: #fff;
  color: var(--primary);
  box-shadow: 0 2rpx 8rpx rgba(3, 105, 161, 0.18);
}
.row-ico {
  width: 69rpx;
  height: 69rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fb-badge {
  flex-shrink: 0;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  margin-right: 6rpx;
  border-radius: 9999rpx;
  background: #f97316;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bind-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.bind-btn::after {
  border: none;
}

.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 0 10rpx;
}

/* ==================== 孩子资料（微信「我的」风格）：头像昵称行 + 手机号行 ==================== */
.profile-card {
  display: flex;
  flex-direction: column;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx -12rpx rgba(14, 165, 233, 0.18);
  position: relative;
  overflow: hidden;
}
/* 资料卡内的行（头像昵称行 / 手机号行），微信「我的」单元格样式 */
.pc-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}
/* 手机号行：下方还有细链接行，底部留白收窄 */
.pc-row-phone {
  padding-bottom: 14rpx;
}
/* 手机号行下的次要操作行：小链接 + 说明，独立一行不与主行抢宽 */
.pc-subrow {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 0 16rpx 89rpx; /* 左对齐正文列（图标 69 + gap 20） */
}
.pc-link {
  font-size: 20rpx;
  color: #94a3b8;
  padding: 4rpx 0;
}
.pc-link:active {
  color: var(--primary);
}
/* 首次进入引导条 */
.pc-guide {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  margin-bottom: 6rpx;
}
.pc-guide-btn {
  flex-shrink: 0;
  padding: 12rpx 30rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #f97316, #fb923c);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(249, 115, 22, 0.5);
}
.profile-card::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -70rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.12), rgba(56, 189, 248, 0));
  pointer-events: none;
}
/* 从首页「资料」入口进来时闪一下边框，告诉家长改哪里 */
.pf-focus {
  animation: pfGlow 1.2s ease-in-out 2;
}
@keyframes pfGlow {
  0%,
  100% {
    box-shadow: 0 8rpx 24rpx -12rpx rgba(14, 165, 233, 0.18);
  }
  50% {
    box-shadow: 0 0 0 6rpx rgba(14, 165, 233, 0.18), 0 10rpx 28rpx -10rpx rgba(14, 165, 233, 0.4);
  }
}
.pf-ava-wrap {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  flex-shrink: 0;
}
.pf-ava {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0369a1, #38bdf8);
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 18rpx rgba(3, 105, 161, 0.22);
  display: block;
}
.pf-ava-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.pf-cam {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0369a1, #38bdf8);
  border: 3rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(3, 105, 161, 0.28);
}
.pf-name {
  font-size: 38rpx;
  line-height: 46rpx;
  font-weight: 700;
  color: var(--text-primary);
  max-width: 300rpx;
}

/* ---- 昵称编辑半屏 ---- */
.nick-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.42);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.nick-sheet {
  width: 100%;
  padding: 30rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  animation: nickUp 0.22s ease-out;
}
@keyframes nickUp {
  from {
    transform: translateY(60rpx);
    opacity: 0.4;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.nick-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nick-close {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nick-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 100rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f7f5fd;
  border: 2rpx solid rgba(14, 165, 233, 0.16);
}
.nick-field-err {
  border-color: rgba(249, 115, 22, 0.6);
  background: #fff7ed;
}
.nick-input {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}
.nick-count {
  font-size: 21rpx;
  color: #94a3b8;
  flex-shrink: 0;
}
.nick-count-err {
  color: #f97316;
  font-weight: 600;
}
.nick-err {
  font-size: 21rpx;
  color: #f97316;
  padding-left: 6rpx;
}
.nick-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}
.nick-btn {
  height: 92rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}
.nick-btn-ghost {
  background: #f4f1fb;
}
.nick-btn-primary {
  flex: 1.6;
  background: linear-gradient(135deg, #0369a1, #38bdf8);
  box-shadow: 0 10rpx 24rpx -8rpx rgba(14, 165, 233, 0.5);
}

/* ---- 安全重置（三档清理 + 长按确认） ---- */
.clear-plan {
  display: flex;
  gap: 14rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 3rpx solid rgba(148, 163, 184, 0.18);
}
.clear-plan.on {
  border-color: #0ea5e9;
  box-shadow: 0 12rpx 30rpx -14rpx rgba(14, 165, 233, 0.45);
}
.clear-radio {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid #cbd5e1;
  flex-shrink: 0;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.clear-radio.on {
  border-color: #0ea5e9;
  background:
    radial-gradient(circle at center, #0369a1 0, #0369a1 10rpx, transparent 11rpx);
}
.clear-tag {
  font-size: 19rpx;
  font-weight: 700;
  color: #007650;
  background: #dcfce7;
  padding: 3rpx 14rpx;
  border-radius: 9999rpx;
}
.clear-chip {
  font-size: 19rpx;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
  color: #64748b;
}
.clear-chip.del {
  background: #fef2f2;
  color: #b91c1c;
}
.clear-chip.keep {
  background: #ecfdf5;
  color: #047857;
}
.clear-warn {
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff7ed;
}
.clear-alert {
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  border: 2rpx solid #fed7aa;
}
.clear-card {
  border-radius: 22rpx;
  background: #f8fafc;
  padding: 20rpx 22rpx;
}
.clear-dot {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
}
.clear-li {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 13rpx 0;
  border-bottom: 2rpx dashed rgba(148, 163, 184, 0.25);
}
.clear-li:last-child {
  border-bottom: none;
}
.clear-backup {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #f0f9ff;
}
.hold-btn {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  background: radial-gradient(circle at 30% 25%, #fb7185, #e11d48 70%);
  box-shadow: 0 26rpx 56rpx -18rpx rgba(225, 29, 72, 0.6);
}
.hold-fill {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0%;
  background: rgba(255, 255, 255, 0.22);
  transition: height 0.07s linear;
}
.hold-txt {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 学习报告图片弹窗 */
.report-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 920px;
}
.report-img-wrap {
  min-height: 560rpx;
  border-radius: 20rpx;
  background: #f5f8fc;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.report-img {
  width: 100%;
  height: 560rpx;
}
.report-loading {
  padding: 120rpx 0;
}

/* ---- 书单详情弹窗（分句进度） ---- */
.group-sheet {
  max-height: 80vh;
}
.gs-list {
  max-height: 44vh;
  margin: 2rpx -6rpx 0;
  padding: 0 6rpx;
}
.gs-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.16);
}
.gs-row:last-child {
  border-bottom: none;
}
.gs-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.gs-idx-read {
  background: #d1fae5;
  color: #047857;
}
.gs-idx-heard {
  background: #fef3c7;
  color: #b45309;
}
.gs-idx-todo {
  background: #f1f5f9;
  color: #64748b;
}
.gs-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.gs-text-read {
  color: var(--text-tertiary);
  text-decoration: line-through;
  text-decoration-color: rgba(148, 163, 184, 0.5);
}
.gs-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.gs-badge-read {
  background: #ecfdf5;
}
.gs-badge-read text {
  color: #047857;
}
.gs-badge-heard {
  background: #fffbeb;
}
.gs-badge-heard text {
  color: #b45309;
}
.gs-badge-todo {
  background: #f8fafc;
}
.gs-badge-todo text {
  color: #94a3b8;
}
.gs-now {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #f97316;
  font-weight: 600;
}
.gs-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: var(--primary);
  box-shadow: 0 8rpx 20rpx rgba(3, 105, 161, 0.28);
}
