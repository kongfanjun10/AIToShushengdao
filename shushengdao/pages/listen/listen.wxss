.page {
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 导航 */
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back-btn {
  width: 84rpx;
  height: 84rpx;
  margin-left: -15rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hover-bg {
  background: rgba(0, 0, 0, 0.05);
}
.rate-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* 主体 */
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 两阶段指示 */
.stage {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.stage-step {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}
.stage-n {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 19rpx;
  line-height: 34rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stage-step.on .stage-n {
  background: var(--primary);
  color: #fff;
}
.stage-line {
  flex: 1;
  height: 4rpx;
  border-radius: 9999rpx;
  background: #e2e8f0;
  overflow: hidden;
}
.stage-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #22d3ee);
  transition: width 0.35s ease;
}

/* 大字句子卡 */
.say-card {
  position: relative;
  background: var(--surface-white);
  border-radius: 31rpx;
  padding: 30rpx 32rpx 26rpx;
  border: 1px solid var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  transition: box-shadow 0.3s ease;
}
.say-on {
  box-shadow: 0 15rpx 46rpx -8rpx rgba(14, 165, 233, 0.24), 0 4rpx 15rpx rgba(15, 23, 42, 0.04);
  border-color: rgba(3, 105, 161, 0.18);
}
.amb-a {
  position: absolute;
  top: -46rpx;
  right: -46rpx;
  width: 215rpx;
  height: 215rpx;
  border-radius: 50%;
  background: rgba(237, 233, 254, 0.5);
}
.amb-b {
  position: absolute;
  bottom: -38rpx;
  left: -38rpx;
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  background: rgba(209, 250, 229, 0.55);
}
.core-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
}
/* 逐字注音：拼音压在字正上方，一字一列 */
.say-ruby {
  padding: 8rpx 0 4rpx;
  z-index: 2;
}
.say-ruby .ruby {
  min-width: 46rpx;
  transition: transform 0.18s ease;
}
/* 播放高亮：当前朗读字列放大 + 主题色（拼音随字同步） */
.say-ruby .ruby-hl {
  transform: scale(1.18);
}
.say-ruby .ruby-hl .ruby-char {
  color: var(--primary, #0369a1);
  text-shadow: 0 2rpx 8rpx rgba(3, 105, 161, 0.25);
}
.say-ruby .ruby-hl .ruby-py {
  color: var(--primary, #0369a1);
  font-weight: 700;
}
.say-ruby .ruby-py {
  font-size: 20rpx;
  height: 30rpx;
  line-height: 30rpx;
}
.say-ruby .ruby-char {
  font-size: 50rpx;
  line-height: 74rpx;
}
.say-ruby .ruby-punct .ruby-char {
  font-size: 44rpx;
}

/* 波形 */
.wave {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  z-index: 2;
  padding: 0 8rpx;
}
.bar {
  width: 8rpx;
  border-radius: 9999rpx;
  background: #e2dcf7;
  transform-origin: center;
  transition: background 0.25s ease;
}
.wave-on .bar {
  background: linear-gradient(180deg, #0369a1, #22d3ee);
  animation: bounceY 1.1s ease-in-out infinite;
}

/* 播放区：光晕 + 波纹 + 按钮共用一个同心圆形舞台，永远居中 */
.play-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0 4rpx;
}
.play-stage {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 底层柔光：径向渐变、边缘自然消散，不会压到下方文字 */
.play-halo {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: radial-gradient(
    circle at 35% 30%,
    rgba(34, 211, 238, 0.4),
    rgba(3, 105, 161, 0.26) 52%,
    rgba(3, 105, 161, 0) 74%
  );
  opacity: 0.45;
  transition: opacity 0.3s ease;
}
.stage-on .play-halo {
  opacity: 1;
  animation: haloPulse 1.8s ease-in-out infinite;
}
/* 播放中的扩散波纹：两圈交替，透明圆环向外扩 */
.play-ring {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(3, 105, 161, 0.55);
  opacity: 0;
}
.stage-on .play-ring {
  animation: ripple 1.9s ease-out infinite;
}
.stage-on .play-ring.r2 {
  animation-delay: 0.95s;
}
.play-btn {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: linear-gradient(45deg, #0369a1, #0369a1 55%, #0ea5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(3, 105, 161, 0.32);
  transition: transform 0.15s ease;
}
@keyframes haloPulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.55;
    transform: scale(0.95);
  }
}
@keyframes ripple {
  0% {
    transform: scale(0.74);
    opacity: 0.5;
  }
  80%,
  100% {
    transform: scale(1.28);
    opacity: 0;
  }
}
.chip {
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.chip-on {
  background: var(--accent-purple-light);
  border-color: #ddd0ff;
}
.mini-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.6);
}

/* 语音不可用提示 */
.warn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 23rpx;
  background: #fffbeb;
  border: 1px solid #fde68a;
}
.warn-btn {
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.06);
  flex-shrink: 0;
}

/* 句子清单 */
.list-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 31rpx;
  padding: 24rpx 20rpx 16rpx;
  border: 1px solid var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.list-scroll {
  max-height: 330rpx;
}
.s-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 14rpx;
  border-radius: 19rpx;
  margin-bottom: 6rpx;
}
.s-hover {
  background: #f8fafc;
}
.s-on {
  background: var(--accent-purple-light);
}
.s-idx {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.s-heard {
  background: #d1fae5;
  color: #007650;
}
.s-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.s-on .s-text {
  color: var(--primary);
  font-weight: 600;
}

/* 底部行动区 */
.cta-bar {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 8rpx 0 4rpx;
}
.btn-main {
  height: 100rpx;
  border-radius: 9999rpx;
  background: linear-gradient(45deg, #0369a1, #0369a1 55%, #0ea5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 12rpx 30rpx rgba(3, 105, 161, 0.3);
}
.pressed {
  transform: scale(0.97);
  opacity: 0.92;
}

/* ===== 音色胶囊置灰 ===== */
.chip-dim {
  opacity: 0.55;
}

/* ===== 音色选择半屏面板 ===== */
.v-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0);
  visibility: hidden;
  transition: background 0.25s ease, visibility 0.25s;
  z-index: 60;
}
.v-mask.v-show {
  background: rgba(15, 23, 42, 0.4);
  visibility: visible;
}
.v-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 -8rpx 30rpx rgba(15, 23, 42, 0.12);
}
.v-sheet.v-up {
  transform: translateY(0);
}
.v-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #e2e8f0;
  margin: 0 auto 4rpx;
}
.v-done {
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light, #f1e9ff);
}
.v-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid #eef0f5;
  background: #fafbfd;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.v-item.v-on {
  border-color: #0369a1;
  background: #f0f9ff;
}
.v-hover {
  background: #f1f3f8;
}
.v-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #eef0f5;
  display: flex;
  align-items: center;
  justify-content: center;
}
