.page {
  min-height: 100vh;
  padding-bottom: 420rpx; /* 给固定键盘留位置 */
}

/* ---------- 导航 ---------- */
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hd-left {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.hd-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.back-btn {
  width: 84rpx;
  height: 84rpx;
  margin-left: -15rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hover-bg {
  background: rgba(0, 0, 0, 0.05);
}
.today-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--card-border);
  color: var(--primary);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}
.chip-timer {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-color: rgba(249, 115, 22, 0.36);
  color: #c2410c;
}
.chip-timer .ico {
  color: #c2410c;
}

/* ---------- 主体 ---------- */
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.pressed {
  transform: scale(0.985);
  opacity: 0.95;
}

/* 难度 */
.lv-scroll {
  width: 100%;
  white-space: nowrap;
}
.lv-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 2rpx 0;
}
.lv-chip {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.18);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.lv-name {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.lv-sub {
  font-size: 18rpx;
  line-height: 24rpx;
  color: var(--text-tertiary);
}
.lv-on {
  background: linear-gradient(135deg, #00687a, #0891b2);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(8, 145, 178, 0.28);
}
.lv-on .lv-name,
.lv-on .lv-sub {
  color: #fff;
}
.lv-desc {
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--text-tertiary);
  padding: 0 4rpx;
}

/* 题卡 */
.paper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 30rpx 18rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 2rpx solid transparent;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}
.paper-ok {
  border-color: rgba(16, 185, 129, 0.55);
  box-shadow: 0 14rpx 46rpx rgba(16, 185, 129, 0.18);
}
.paper-bad {
  border-color: rgba(249, 115, 22, 0.5);
  box-shadow: 0 14rpx 46rpx rgba(249, 115, 22, 0.14);
}
.paper-glow {
  position: absolute;
  left: 50%;
  top: -180rpx;
  transform: translateX(-50%);
  width: 560rpx;
  height: 460rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(206, 246, 255, 0.85), rgba(125, 211, 252, 0.3) 58%, transparent 74%);
  pointer-events: none;
}
.q-badge {
  padding: 5rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(8, 145, 178, 0.12);
  color: #00687a;
  z-index: 2;
}
.dots {
  display: flex;
  align-items: center;
  gap: 6rpx;
  z-index: 2;
  min-height: 12rpx;
}
.hdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.hdot-ok {
  background: #10b981;
}
.hdot-bad {
  background: #fb923c;
}
.hdot-empty {
  background: rgba(148, 163, 184, 0.35);
}

.expr {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 26rpx 0 14rpx;
  z-index: 2;
  flex-wrap: nowrap;
}
.num {
  font-family: "DIN Alternate", "SF Pro Rounded", "Helvetica Neue", Arial, sans-serif;
  font-size: 96rpx;
  line-height: 1;
  font-weight: 800;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
}
.op,
.eq {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 700;
  color: #64748b;
}
.ans {
  min-width: 132rpx;
  height: 112rpx;
  padding: 0 14rpx;
  border-radius: 22rpx;
  background: rgba(241, 245, 249, 0.9);
  border: 3rpx dashed rgba(148, 163, 184, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.ans-ok {
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  border-color: #10b981;
  border-style: solid;
}
.ans-bad {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-color: #fb923c;
  border-style: solid;
}
.ans-txt {
  font-family: "DIN Alternate", "SF Pro Rounded", "Helvetica Neue", Arial, sans-serif;
  font-size: 84rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}
.caret {
  width: 4rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  background: var(--primary);
  animation: blink 1s step-end infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.tip {
  font-size: 25rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  z-index: 2;
}
.tip-ok {
  color: #047857;
  font-weight: 700;
}
.tip-bad {
  color: #c2410c;
  font-weight: 700;
}

.q-tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  padding-top: 8rpx;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
  z-index: 2;
}
.qtool {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 14rpx;
  border-radius: 9999rpx;
}
.qtool-right {
  margin-left: auto;
}

/* 反馈 */
.fb {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: 26rpx;
  border: 1px solid transparent;
  animation: fbIn 0.24s ease-out;
}
@keyframes fbIn {
  0% { opacity: 0; transform: translateY(12rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.fb-ok {
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  border-color: rgba(16, 185, 129, 0.26);
}
.fb-bad {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-color: rgba(249, 115, 22, 0.3);
}
.fb-emoji {
  font-size: 42rpx;
  line-height: 1;
  flex-shrink: 0;
}
.fb-title {
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 700;
  display: block;
}
.fb-ok .fb-title {
  color: #047857;
}
.fb-bad .fb-title {
  color: #c2410c;
}
.fb-sub {
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--text-secondary);
  display: block;
}
.fb-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.fb-btn {
  padding: 12rpx 18rpx;
  border-radius: 9999rpx;
  font-size: 21rpx;
  line-height: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.fb-btn.ghost {
  background: #fff;
  color: var(--text-secondary);
  border: 1px solid rgba(148, 163, 184, 0.42);
}
.fb-btn.solid {
  background: linear-gradient(135deg, #0369a1, #0ea5e9);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(14, 165, 233, 0.26);
}
.fb-skip {
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #047857;
  flex-shrink: 0;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  padding: 16rpx 10rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}
.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.st-n {
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.st-l {
  font-size: 19rpx;
  line-height: 26rpx;
  color: var(--text-tertiary);
}
.st-hair {
  width: 1px;
  height: 40rpx;
  background: rgba(148, 163, 184, 0.24);
}

.only-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(8, 145, 178, 0.14);
}
.only-btn {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  font-size: 21rpx;
  line-height: 26rpx;
  font-weight: 600;
  color: #00687a;
  background: rgba(8, 145, 178, 0.12);
}
.only-on {
  background: linear-gradient(135deg, #00687a, #0891b2);
  color: #fff;
}

/* ---------- 数字键盘 ---------- */
.pad {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  padding: 14rpx 38rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(249, 249, 255, 0) 0%, rgba(249, 249, 255, 0.96) 26%, #f9f9ff 100%);
}
.pad-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.key {
  width: calc((100% - 24rpx) / 3);
  height: 96rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1px solid rgba(148, 163, 184, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "DIN Alternate", "SF Pro Rounded", "Helvetica Neue", Arial, sans-serif;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 700;
  color: #0f172a;
}
.key-hover {
  transform: scale(0.95);
  background: #f1f5f9;
}
.key-fn {
  background: #f8fafc;
  color: var(--text-secondary);
}
.key-ok {
  background: linear-gradient(135deg, #0369a1, #0ea5e9);
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.3);
}

/* ---------- 结算 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.result {
  width: 100%;
  padding: 36rpx 30rpx 26rpx;
  border-radius: 36rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  animation: fbIn 0.26s ease-out;
}
.res-emoji {
  font-size: 76rpx;
  line-height: 1;
}
.res-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.res-row {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 16rpx 0;
}
.res-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.res-n {
  font-size: 48rpx;
  line-height: 54rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.res-l {
  font-size: 19rpx;
  line-height: 26rpx;
  color: var(--text-tertiary);
}
.res-tip {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
  text-align: center;
}
.res-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 10rpx;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #0ea5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 12rpx 30rpx rgba(14, 165, 233, 0.3);
}
.res-quit {
  padding: 12rpx 20rpx;
  border-radius: 9999rpx;
}
