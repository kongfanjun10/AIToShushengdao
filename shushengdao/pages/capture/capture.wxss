.page {
  min-height: 100vh;
  padding-bottom: 460rpx;
}
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back-btn {
  width: 69rpx;
  height: 69rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
}
.hover-bg {
  background: rgba(3, 105, 161, 0.06);
}
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 步骤指示 */
.step-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.step-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #cbd5e1;
}
.step-dot.on {
  background: var(--primary);
}
.step-dot.done {
  background: #4edea3;
}
.step-line {
  width: 24rpx;
  height: 2rpx;
  background: #e2e8f0;
}

/* 拍摄提示卡 */
.tip-card {
  background: #fff;
  border-radius: 31rpx;
  padding: 26rpx;
}
.tip-ico {
  width: 77rpx;
  height: 77rpx;
  border-radius: 23rpx;
  background: linear-gradient(135deg, #0369a1, #38bdf8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(3, 105, 161, 0.25);
  flex-shrink: 0;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}
.count-pill {
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
  color: #0ea5e9;
  font-size: 19rpx;
  font-weight: 600;
}

/* 图片网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}
.shot {
  position: relative;
  width: 206rpx;
  height: 206rpx;
  border-radius: 23rpx;
  overflow: hidden;
  background: #e7eeff;
  box-shadow: 0 8rpx 20rpx -6rpx rgba(14, 165, 233, 0.18);
}
.shot-img {
  width: 100%;
  height: 100%;
  display: block;
}
.shot-idx {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 6rpx;
  border-radius: 9999rpx;
  background: rgba(3, 105, 161, 0.9);
  color: #fff;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-align: center;
}
.shot-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.shot-ops {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  display: flex;
  justify-content: space-between;
}
.op {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.12);
}
.op-off {
  opacity: 0.25;
}
.add-tile {
  width: 206rpx;
  height: 206rpx;
  border-radius: 23rpx;
  border: 2rpx dashed #bfa9e8;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 空状态 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 30rpx 0 10rpx;
}
.empty-art {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

/* 识别结果卡 */
.result-card {
  background: #fff;
  border-radius: 31rpx;
  padding: 26rpx;
}
.ok-badge {
  width: 69rpx;
  height: 69rpx;
  border-radius: 23rpx;
  background: linear-gradient(135deg, #005b3d, #4edea3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mode-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  font-weight: 600;
}
.mode-live {
  background: #d1fae5;
  color: #005b3d;
}
.mode-mock {
  background: #fef3c7;
  color: #92400e;
}
.mini-stats {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px dashed #e6e1f5;
}
.mini-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  align-items: center;
}
.mock-warn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: var(--warning-bg);
  border-radius: 20rpx;
}

/* 句子列表 */
.sent-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sent {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #fff;
  border-radius: 23rpx;
  padding: 18rpx 16rpx;
  box-shadow: 0 4rpx 16rpx -6rpx rgba(14, 165, 233, 0.12);
}
.sent-idx {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--accent-purple-light);
  color: #0ea5e9;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
}
.sent-body {
  flex: 1;
  min-width: 0;
}
.sent-text {
  font-size: 27rpx;
  line-height: 42rpx;
  color: var(--text-primary);
}
.sent-input {
  width: 100%;
  font-size: 27rpx;
  line-height: 42rpx;
  color: var(--text-primary);
  min-height: 42rpx;
}
.sent-meta {
  margin-top: 2rpx;
}
.sent-ops {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
}
.sent-op {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-sentence {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 20rpx;
  border-radius: 23rpx;
  border: 2rpx dashed #bfa9e8;
  background: rgba(255, 255, 255, 0.6);
}

/* 底部操作（上浮：给底部任务栏留出位置） */
.bottom-bar {
  position: fixed;
  left: 38rpx;
  right: 38rpx;
  bottom: calc(178rpx + env(safe-area-inset-bottom));
  z-index: 40;
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 9999rpx;
  box-shadow: 0 12rpx 34rpx -8rpx rgba(15, 23, 42, 0.2);
}
.btn-ghost {
  width: 176rpx;
  height: 92rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
  color: var(--primary);
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-main {
  flex: 1;
  height: 92rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #0369a1, #38bdf8);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 12rpx 26rpx -8rpx rgba(3, 105, 161, 0.55);
}
.btn-disabled {
  opacity: 0.45;
}
.pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

/* 识别遮罩 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.scan-card {
  width: 100%;
  background: #fff;
  border-radius: 38rpx;
  padding: 40rpx 34rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.scan-visual {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}
.scan-ring {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(3, 105, 161, 0.12);
  border-top-color: #0369a1;
  animation: spin 1.1s linear infinite;
}
.scan-doc {
  width: 120rpx;
  height: 120rpx;
  border-radius: 26rpx;
  background: var(--accent-purple-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.scan-beam {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 40rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(3, 105, 161, 0), #0369a1, rgba(3, 105, 161, 0));
  animation: beam 1.4s ease-in-out infinite;
}
@keyframes beam {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  50% {
    transform: translateY(80rpx);
    opacity: 1;
  }
}
.scan-progress {
  width: 100%;
  height: 10rpx;
  border-radius: 9999rpx;
  background: #e0f2fe;
  overflow: hidden;
  margin-top: 10rpx;
}
.scan-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #0369a1, #22d3ee);
  transition: width 0.3s ease;
}
.scan-list {
  width: 100%;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1px dashed #e6e1f5;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  max-height: 260rpx;
  overflow: hidden;
}
.scan-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot-wait {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cbd5e1;
}
.dot-run {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0369a1;
  animation: pulse 1s ease-in-out infinite;
}
