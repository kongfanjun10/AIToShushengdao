<view class="page">
  <!-- 顶部导航 -->
  <view class="hd" style="padding-top:{{statusBar}}px">
    <view class="hd-inner" style="height:{{navH}}px;padding-right:{{navRight}}px">
      <view class="row hd-left" style="gap:8rpx">
        <view class="back-btn" hover-class="hover-bg" bindtap="goBack">
          <view class="ico ico-chevron-left ico-42"></view>
        </view>
        <view class="col" style="gap:0;min-width:0">
          <text class="t-18">图案与数字连线</text>
          <text class="t-10 c-t truncate">数小动物，找数字，连一连</text>
        </view>
      </view>
      <view class="hd-right">
        <view class="today-chip" hover-class="pressed" bindtap="reShuffle">
          <view class="ico ico-refresh ico-26"></view>
          <text class="t-10 semi">打乱</text>
        </view>
      </view>
    </view>
  </view>

  <view class="main" style="padding-top:{{statusBar + navH + 2}}px">
    <!-- 难度 -->
    <scroll-view class="lv-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="lv-row">
        <view
          class="lv-chip {{item.key === levelKey ? 'lv-on' : ''}}"
          wx:for="{{levels}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="pickLevel"
          hover-class="pressed"
        >
          <text class="lv-name">{{item.name}}</text>
          <text class="lv-sub">{{item.sub}}</text>
        </view>
      </view>
    </scroll-view>

    <text class="lv-desc">{{levelDesc}}</text>

    <!-- 连线棋盘 -->
    <view class="paper">
      <view class="paper-glow"></view>
      <view class="row between" style="z-index:2;width:100%">
        <view class="q-badge">
          <text class="t-10 semi">第 {{round}} 轮 · 已连 {{matchedCount}}/{{total}}</text>
        </view>
        <text class="t-10 c-t">按住{{levelTip}}，拖到数字上松手</text>
      </view>

      <view class="board" id="board">
        <!-- 已连对的线（层在卡片下面，只从两列之间的空隙露出来） -->
        <view
          class="ln"
          wx:for="{{lines}}"
          wx:key="key"
          style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.len}}px;transform:rotate({{item.ang}}deg)"
        ></view>

        <!-- 手指正在拖的线：跟着手指走，松手才判分 -->
        <view
          wx:if="{{drag}}"
          class="ln ln-live"
          style="left:{{drag.x}}px;top:{{drag.y}}px;width:{{drag.len}}px;transform:rotate({{drag.ang}}deg)"
        ></view>

        <!-- 左列：小动物数量卡（按住可拖出连线，连线从卡片右边缘出发） -->
        <view class="col-list">
          <view
            id="lc-{{index}}"
            class="lc-item {{actSide === 'L' && actIdx === index ? 'lc-act' : ''}} {{matchedL[index] ? 'lc-done' : ''}} {{shakeL === index ? 'shake' : ''}}"
            style="height:{{cardH}}rpx"
            wx:for="{{left}}"
            wx:key="n"
            data-side="L"
            data-i="{{index}}"
            bindtouchstart="onGrab"
            catchtouchmove="onDragMove"
            bindtouchend="onDragEnd"
            bindtouchcancel="onDragEnd"
          >
            <view class="face-grid">
              <view class="f-row" wx:for="{{item.cells}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
                <view class="f-cell" wx:for="{{row}}" wx:for-item="cell" wx:for-index="ci" wx:key="ci">
                  <text class="f-emoji" wx:if="{{cell}}">{{item.animal}}</text>
                </view>
              </view>
            </view>
            <view class="ln-handle" wx:if="{{!matchedL[index]}}"></view>
            <view class="lc-check" wx:if="{{matchedL[index]}}">
              <view class="ico ico-check ico-22" style="color:#fff"></view>
            </view>
          </view>
        </view>

        <!-- 右列：数字（等高，可以从这边反向拖到小动物卡，连线落在卡片左边缘） -->
        <view class="col-list col-right">
          <view
            id="rc-{{index}}"
            class="rc-item {{actSide === 'R' && actIdx === index ? 'rc-act' : ''}} {{matchedR[index] ? 'rc-done' : ''}} {{shakeR === index ? 'shake' : ''}}"
            style="height:{{cardH}}rpx"
            wx:for="{{right}}"
            wx:key="n"
            data-side="R"
            data-i="{{index}}"
            bindtouchstart="onGrab"
            catchtouchmove="onDragMove"
            bindtouchend="onDragEnd"
            bindtouchcancel="onDragEnd"
          >
            <view class="rc-handle" wx:if="{{!matchedR[index]}}"></view>
            <text class="rc-num">{{item.n}}</text>
            <view class="lc-check" wx:if="{{matchedR[index]}}">
              <view class="ico ico-check ico-22" style="color:#fff"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="note-row">
        <view class="ico ico-bulb ico-30" style="color:#fbbf24"></view>
        <text class="t-10 c-t">数一数小动物有几只，拖到对应的数字上；连错了会抖一下，再试一次。</text>
      </view>
    </view>

    <!-- 今日战绩 -->
    <view class="stat-row">
      <view class="stat">
        <text class="stat-num">{{stats.todayRight}}</text>
        <text class="stat-lab">今日连对</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.todayWrong}}</text>
        <text class="stat-lab">连错</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.percent}}%</text>
        <text class="stat-lab">正确率</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{doneRounds}}</text>
        <text class="stat-lab">完成轮数</text>
      </view>
    </view>
  </view>
</view>
