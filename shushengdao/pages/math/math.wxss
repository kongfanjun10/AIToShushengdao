.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

/* ---------- 导航 ---------- */
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hd-left {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.back-btn {
  width: 84rpx;
  height: 84rpx;
  margin-left: -15rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hover-bg {
  background: rgba(0, 0, 0, 0.05);
}
.today-chip {
  flex-shrink: 0;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* ---------- 主体 ---------- */
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pressed {
  transform: scale(0.985);
  opacity: 0.95;
}

/* ---------- 区间条 ---------- */
.range-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 13rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}
.range-num {
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 700;
  color: var(--secondary);
  font-variant-numeric: tabular-nums;
}
.range-tip {
  font-size: 19rpx;
  color: var(--text-tertiary);
}
.range-edit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
}

/* ---------- 题面卡 ---------- */
.paper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 22rpx 30rpx 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 2rpx solid transparent;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}
.paper-ok {
  border-color: rgba(16, 185, 129, 0.55);
  box-shadow: 0 14rpx 46rpx rgba(16, 185, 129, 0.18);
}
.paper-bad {
  border-color: rgba(249, 115, 22, 0.5);
  box-shadow: 0 14rpx 46rpx rgba(249, 115, 22, 0.14);
}
.paper-glow {
  position: absolute;
  left: 50%;
  top: -160rpx;
  transform: translateX(-50%);
  width: 560rpx;
  height: 480rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(125, 211, 252, 0.8), rgba(172, 237, 255, 0.28) 58%, transparent 74%);
  pointer-events: none;
}
.q-badge {
  padding: 5rpx 16rpx;
  border-radius: 9999rpx;
  background: var(--accent-purple-light);
  color: var(--primary);
  z-index: 2;
}
.dots {
  display: flex;
  align-items: center;
  gap: 6rpx;
  z-index: 2;
}
.hdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.hdot-ok {
  background: #10b981;
}
.hdot-bad {
  background: #fb923c;
}
.hdot-empty {
  background: rgba(148, 163, 184, 0.35);
}

.num-stage {
  position: relative;
  width: 100%;
  min-height: 268rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.num-big {
  font-family: "DIN Alternate", "SF Pro Rounded", "Helvetica Neue", Arial, sans-serif;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #1e1b4b;
  font-variant-numeric: tabular-nums;
}
.num-in {
  animation: numIn 0.34s cubic-bezier(0.2, 0.9, 0.3, 1);
}
@keyframes numIn {
  0% {
    opacity: 0;
    transform: translateX(70rpx) scale(0.84);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.ok-pop {
  position: absolute;
  right: 6rpx;
  top: 10rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34d399, #059669);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.35);
  animation: popIn 0.32s cubic-bezier(0.2, 1.4, 0.4, 1);
}
@keyframes popIn {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
.star {
  position: absolute;
  color: #fbbf24;
  font-size: 34rpx;
  animation: starUp 1.1s ease-out forwards;
  pointer-events: none;
}
.s1 {
  left: 14%;
  bottom: 26rpx;
}
.s2 {
  left: 50%;
  bottom: 10rpx;
  animation-delay: 0.12s;
  font-size: 26rpx;
}
.s3 {
  right: 16%;
  bottom: 34rpx;
  animation-delay: 0.24s;
}
@keyframes starUp {
  0% {
    opacity: 0;
    transform: translateY(10rpx) scale(0.6);
  }
  40% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(-90rpx) scale(1.15);
  }
}

.read-tip {
  font-size: 25rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  z-index: 2;
}
.tip-live {
  color: var(--primary);
  font-weight: 600;
}
.hint-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(255, 251, 235, 0.9);
  border: 1px solid rgba(251, 191, 36, 0.2);
  z-index: 2;
}
.hint-btn {
  background: rgba(255, 255, 255, 0.85);
  border-color: rgba(148, 163, 184, 0.22);
}

/* ---------- 录音 ---------- */
.mic-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-top: 4rpx;
}
.wave {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
  height: 78rpx;
  margin-bottom: 4rpx;
}
.wv {
  width: 10rpx;
  border-radius: 9999rpx;
  background: linear-gradient(180deg, #38bdf8, #0369a1);
  transform-origin: bottom center;
  animation: waveBar 1s ease-in-out infinite;
}
@keyframes waveBar {
  0%,
  100% {
    transform: scaleY(0.45);
    opacity: 0.55;
  }
  50% {
    transform: scaleY(1);
    opacity: 1;
  }
}
.mic-btn {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0ea5e9, #0369a1);
  box-shadow: 0 14rpx 34rpx rgba(3, 105, 161, 0.34), inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.12);
  transition: background 0.2s ease, transform 0.12s ease;
}
.mic-hover {
  transform: scale(0.96);
}
.mic-on {
  background: linear-gradient(135deg, #fb923c, #ef4444);
  box-shadow: 0 14rpx 34rpx rgba(239, 68, 68, 0.34), inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.12);
}
.mic-ok {
  background: linear-gradient(135deg, #34d399, #059669);
  box-shadow: 0 14rpx 34rpx rgba(16, 185, 129, 0.32), inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.12);
}
.mic-ring {
  position: absolute;
  left: -14rpx;
  top: -14rpx;
  right: -14rpx;
  bottom: -14rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(239, 68, 68, 0.42);
  animation: ringPing 1.5s ease-out infinite;
}
@keyframes ringPing {
  0% {
    transform: scale(0.92);
    opacity: 0.85;
  }
  70%,
  100% {
    transform: scale(1.32);
    opacity: 0;
  }
}
.mic-label {
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 6rpx;
}
.mic-sub {
  font-size: 19rpx;
  line-height: 28rpx;
  color: var(--text-tertiary);
  text-align: center;
}

/* ---------- 反馈卡 ---------- */
.fb {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 26rpx;
  border: 1px solid transparent;
  animation: fbIn 0.24s ease-out;
}
@keyframes fbIn {
  0% {
    opacity: 0;
    transform: translateY(12rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
.fb-ok {
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  border-color: rgba(16, 185, 129, 0.26);
}
.fb-bad {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-color: rgba(249, 115, 22, 0.3);
}
.fb-retry {
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(148, 163, 184, 0.28);
}
.fb-manual {
  background: linear-gradient(135deg, #fff7ed, #fef3c7);
  border-color: rgba(251, 191, 36, 0.36);
  flex-wrap: wrap;
}
.fb-emoji {
  font-size: 44rpx;
  line-height: 1;
  flex-shrink: 0;
}
.fb-title {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  display: block;
}
.fb-ok .fb-title {
  color: #047857;
}
.fb-bad .fb-title {
  color: #c2410c;
}
.fb-manual .fb-title {
  color: #92400e;
}
.fb-sub {
  font-size: 21rpx;
  line-height: 30rpx;
  color: var(--text-secondary);
  display: block;
}
.fb-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.fb-btn {
  padding: 12rpx 18rpx;
  border-radius: 9999rpx;
  font-size: 21rpx;
  line-height: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.fb-btn.ghost {
  background: #fff;
  color: var(--text-secondary);
  border: 1px solid rgba(148, 163, 184, 0.42);
}
.fb-btn.solid {
  background: linear-gradient(135deg, #0369a1, #0ea5e9);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(14, 165, 233, 0.26);
}
.fb-skip {
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #047857;
  flex-shrink: 0;
}

.replay {
  align-self: center;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(14, 165, 233, 0.16);
}

/* ---------- 今日统计 ---------- */
.stats {
  display: flex;
  align-items: center;
  padding: 18rpx 10rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}
.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.st-n {
  font-size: 38rpx;
  line-height: 44rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.st-l {
  font-size: 19rpx;
  line-height: 26rpx;
  color: var(--text-tertiary);
}
.st-hair {
  width: 1px;
  height: 40rpx;
  background: rgba(148, 163, 184, 0.24);
}

.only-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.7);
}
.only-btn {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--secondary);
  background: rgba(224, 242, 254, 0.9);
  border: 1px solid rgba(0, 104, 122, 0.16);
}
.only-on {
  color: #fff;
  background: linear-gradient(135deg, #00687a, #0891b2);
  border-color: transparent;
}

.note {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  padding: 4rpx 4rpx 0;
}

/* ---------- 区间设置半屏 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
  box-shadow: 0 -12rpx 46rpx rgba(15, 23, 42, 0.14);
  animation: sheetUp 0.26s cubic-bezier(0.2, 0.9, 0.3, 1);
}
@keyframes sheetUp {
  0% {
    transform: translateY(100%);
  }
  100% {
    transform: translateY(0);
  }
}
.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #e2e8f0;
}
.sheet-x {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.range-inputs {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
}
.ri {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 10rpx 0 14rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1px solid rgba(148, 163, 184, 0.2);
}
.ri-label {
  font-size: 19rpx;
  color: var(--text-tertiary);
}
.ri-input {
  width: 100%;
  height: 76rpx;
  text-align: center;
  font-size: 54rpx;
  line-height: 76rpx;
  font-weight: 800;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}
.ri-tilde {
  font-size: 32rpx;
  color: var(--text-tertiary);
  font-weight: 700;
}
.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}
.preset {
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 600;
}
.preset-on {
  background: linear-gradient(135deg, #0369a1, #0ea5e9);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(14, 165, 233, 0.26);
}
.range-err {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.sheet-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #0369a1, #0ea5e9);
  box-shadow: 0 12rpx 30rpx rgba(3, 105, 161, 0.28);
}
.sheet-foot {
  font-size: 19rpx;
  color: var(--text-tertiary);
  text-align: center;
}
