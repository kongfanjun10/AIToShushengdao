.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ---------- 导航 ---------- */
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #f2f9ff;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
}
.hd-inner {
  height: 108rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hd-left {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.hd-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.back-btn {
  width: 84rpx;
  height: 84rpx;
  margin-left: -15rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hover-bg {
  background: rgba(0, 0, 0, 0.05);
}
.today-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--card-border);
  color: var(--primary);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}
.pressed {
  transform: scale(0.985);
  opacity: 0.95;
}

/* ---------- 主体 ---------- */
.main {
  padding: 0 38rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 游戏页签 */
.tabs {
  display: flex;
  gap: 14rpx;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.18);
  color: var(--text-secondary);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.tab-on {
  background: linear-gradient(135deg, #00687a, #0891b2);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(8, 145, 178, 0.28);
}

/* 尺寸档 */
.lv-scroll {
  width: 100%;
  white-space: nowrap;
}
.lv-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 2rpx 0;
}
.lv-chip {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.18);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.lv-name {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.lv-sub {
  font-size: 18rpx;
  line-height: 24rpx;
  color: var(--text-tertiary);
}
.lv-on {
  background: linear-gradient(135deg, #00687a, #0891b2);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(8, 145, 178, 0.28);
}
.lv-on .lv-name,
.lv-on .lv-sub {
  color: #fff;
}

/* ---------- 棋盘卡 ---------- */
.paper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx 20rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
}
.paper-glow {
  position: absolute;
  left: 50%;
  top: -180rpx;
  transform: translateX(-50%);
  width: 560rpx;
  height: 460rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(206, 246, 255, 0.85), rgba(125, 211, 252, 0.3) 58%, transparent 74%);
  pointer-events: none;
}
.q-badge {
  padding: 5rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(8, 145, 178, 0.12);
  color: #00687a;
  z-index: 2;
}

/* ---------- 迷宫（练习册风格，canvas 绘制：utils/mazeDraw.js） ---------- */
/* 迷宫卡：淡奶油底 */
.paper-park {
  background: linear-gradient(180deg, #fffbeb 0%, #fff7ed 60%, rgba(255, 255, 255, 0.97) 100%);
}
.maze-wrap {
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.maze-frame {
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.1);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow 0.18s ease, transform 0.18s ease;
}
.maze-canvas {
  display: block;
}

/* 手指按在盘面上：画框描边亮起 + 轻微放大，孩子知道「现在可以拖」 */
.maze-frame.drag-on {
  box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.28), 0 10rpx 26rpx rgba(15, 23, 42, 0.16);
  transform: scale(1.008);
}

/* 拖动提示行 */
.drag-hint {
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 4rpx 20rpx 2rpx;
  border-radius: 999rpx;
  transition: background 0.18s ease, color 0.18s ease;
}
.drag-hint-on {
  background: rgba(16, 185, 129, 0.12);
}
.maze-tip {
  z-index: 2;
}
.c-ok {
  color: #047857;
}

/* 3×3 滑块盘：绝对定位，方块换位时用 left/top 过渡滑过去 */
.bgrid {
  position: relative;
  z-index: 2;
  width: 548rpx;
  height: 548rpx;
  border-radius: 24rpx;
  background: rgba(8, 145, 178, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(8, 145, 178, 0.08);
}
.btile {
  position: absolute;
  width: 176rpx;
  height: 176rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff, #f0f9ff);
  border: 1px solid rgba(8, 145, 178, 0.22);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: left 0.16s ease, top 0.16s ease, transform 0.16s ease;
}
/* 被按住的方块：抬起来 */
.bdrag {
  z-index: 5;
  transition: none;
  border-color: rgba(8, 145, 178, 0.55);
  box-shadow: 0 18rpx 34rpx rgba(15, 23, 42, 0.2);
}
/* 松手滑向空位：只给 transform 过渡，落地后再切 left/top，视觉上不跳 */
.bdrag.banim {
  transition: transform 0.15s ease;
}
.bnum {
  font-family: "DIN Alternate", "SF Pro Rounded", "Helvetica Neue", Arial, sans-serif;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  color: #00687a;
  font-variant-numeric: tabular-nums;
}
.bblank {
  background: transparent;
  border: 2rpx dashed rgba(148, 163, 184, 0.4);
  box-shadow: none;
}
.btools {
  display: flex;
  gap: 10rpx;
  z-index: 2;
}
.btool {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(148, 163, 184, 0.2);
  color: var(--text-secondary);
}
.note-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ---------- 找不同 ---------- */
.ogrid {
  z-index: 2;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 18rpx;
  padding: 8rpx 0 2rpx;
}
.ocard {
  width: 240rpx;
  height: 240rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff, #f0f9ff);
  border: 2rpx solid rgba(148, 163, 184, 0.28);
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, border-color 0.15s ease;
}
.oc-emoji {
  font-size: 110rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(15, 23, 42, 0.15));
}
/* 答对的那格：绿框点亮 */
.oc-right {
  border-color: rgba(16, 185, 129, 0.8);
  box-shadow: 0 0 0 8rpx rgba(16, 185, 129, 0.16), 0 10rpx 24rpx rgba(16, 185, 129, 0.24);
  transform: scale(1.04);
}
/* 答错抖动 */
.shake {
  animation: shakeX 0.4s ease;
  border-color: rgba(249, 115, 22, 0.7) !important;
}
@keyframes shakeX {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}

/* ---------- 统计 ---------- */
.stat-row {
  display: flex;
  align-items: center;
  padding: 16rpx 10rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.stat-num {
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: #00687a;
}
.stat-lab {
  font-size: 19rpx;
  line-height: 26rpx;
  color: var(--text-tertiary);
}
