@import "../calc/calc.wxss";

/* ---------- 竖式专用 ---------- */
.t-9 {
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 600;
}

.mini-chip {
  display: flex;
  align-items: center;
  gap: 3rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(148, 163, 184, 0.28);
  color: var(--text-secondary);
}
.mini-on {
  background: rgba(8, 145, 178, 0.12);
  border-color: rgba(8, 145, 178, 0.3);
  color: #00687a;
}
.mini-on .ico {
  color: #00687a;
}

.vwrap {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 6rpx 4rpx;
  z-index: 2;
}
.vcol {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 2rpx;
}
.vrow {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
}
.vhead .vlab {
  font-size: 17rpx;
  line-height: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}
.vcell {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "DIN Alternate", "SF Pro Rounded", "Helvetica Neue", Arial, sans-serif;
  font-size: 62rpx;
  line-height: 1;
  font-weight: 700;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
}
.vpad {
  width: 60rpx;
}
.vop {
  font-size: 56rpx;
  color: #0891b2;
  font-weight: 800;
}
.vline {
  display: flex;
  justify-content: flex-end;
  padding: 2rpx 0 6rpx;
}
.vline-in {
  height: 4rpx;
  border-radius: 9999rpx;
  background: rgba(15, 23, 42, 0.55);
}

.vans {
  position: relative;
  width: 84rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: rgba(241, 245, 249, 0.65);
  border: 2rpx dashed rgba(148, 163, 184, 0.45);
  transition: all 0.18s ease;
}
.vans-active {
  background: rgba(206, 246, 255, 0.6);
  border-color: #0891b2;
  border-style: solid;
  box-shadow: 0 0 0 4rpx rgba(8, 145, 178, 0.12);
}
.vans-fill {
  background: #fff;
}
.vans-bad {
  background: #fff7ed;
  border-color: #fb923c;
  border-style: solid;
}
.vans-txt {
  font-family: "DIN Alternate", "SF Pro Rounded", "Helvetica Neue", Arial, sans-serif;
  font-size: 62rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--primary);
}
.vmark {
  position: absolute;
  right: -6rpx;
  top: -10rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #f59e0b;
  color: #fff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(245, 158, 11, 0.4);
}

.tip {
  z-index: 2;
}
.step-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 251, 235, 0.9);
  border: 1px solid rgba(251, 191, 36, 0.22);
  z-index: 2;
  max-width: 100%;
}
